# Local demo only. Never enable LOCAL_DEMO on a publicly exposed real-data deployment.
LOCAL_DEMO=1
# Optional local open model; start Ollama and pull the configured model first.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b
# Optional host-side Codex inference bridge. This does not copy your Codex authentication.
# AI_BRIDGE_URL=http://127.0.0.1:9191
# AI_BRIDGE_TOKEN=

# Optional LM Studio for non-Docker development (host loopback URL):
# OPENAI_MODEL=openai/lfm3-omni-2b
# OPENAI_API_KEY=lm-studio
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
